# Dashboard authentication (required in production, optional in dev)
ADMIN_TOKEN=
# Optional comma-separated browser origins; omit to allow all origins in dev
CORS_ORIGIN=
APP_BASE_URL=http://localhost:3000
PORT=3000

# Agent token hashing (required in production, minimum 16 characters)
AGENT_TOKEN_PEPPER=
# Secret for the seeded operations-agent demo token. Set a strong value in production.
DEMO_AGENT_SECRET=
SESSION_SECRET=

# Audit ledger HMAC key (minimum 16 characters in production)
LEDGER_HASH_SECRET=

# PayPal Payouts (Sandbox by default)
PAYPAL_BUSINESS_ACCOUNT_EMAIL=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_WEBHOOK_ID=
# In production, payouts fail closed without credentials unless this is true.
PAYPAL_SIMULATE=false

# AI policy drafting / explanations
AI_ENABLED=true
AI_API_KEY=
AI_MODEL=gemini-3.5-flash
# Tried in order if the primary model is retired, overloaded or slow.
AI_MODEL_FALLBACKS=gemini-3.6-flash,gemini-3-flash-preview,gemini-3.1-flash-lite
AI_PROVIDER=
GEMINI_API_KEY=
# Optional second key, tried when the first is rate-limited. Quota is per Google project, so use a key from a different project.
GEMINI_API_KEY_2=

# Set to a PostgreSQL URL for durable state; run `npm run db:push` once.
# Omit to run the in-memory demo store.
DATABASE_URL=

# Receiver for the seeded demo recipient (use a PayPal sandbox personal account email)
DEMO_RECIPIENT_EMAIL=
